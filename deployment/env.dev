# Development environment variables
# Copy this file to .env for local development

# Flask configuration
FLASK_ENV=development
FLASK_APP=app.py

# Security (use a simple key for development)
SECRET_KEY=dev-secret-key-change-in-production

# CORS settings (allow all in development)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# File upload settings
MAX_FILE_SIZE=16777216

# Logging
LOG_LEVEL=DEBUG

# Telegram Bot Configuration
# Get your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Access Control - Comma-separated list of allowed Telegram user IDs
# Leave empty to allow all users, or add specific user IDs like: 123456789,987654321
# To get a user ID, use the get_telegram_user_id.py script
ALLOWED_USER_IDS=123456789,987654321
