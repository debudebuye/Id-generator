# Environment variables for production deployment
# Copy this file to .env and fill in your actual values

# Flask configuration
FLASK_ENV=production
FLASK_APP=deployment/wsgi.py

# Security
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# Database (if you add one later)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# CORS settings
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# File upload settings
MAX_FILE_SIZE=16777216

# Logging
LOG_LEVEL=INFO

# Telegram Bot Configuration
# Get your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Access Control - Comma-separated list of allowed Telegram user IDs
# IMPORTANT: Set this to restrict access to specific users only
# Format: 123456789,987654321,555666777
# To get a user ID, use the get_telegram_user_id.py script
ALLOWED_USER_IDS=123456789,987654321

# External services (if you add them later)
# REDIS_URL=redis://localhost:6379/0
